# Copy to .env.local (never commit the real file).

# Admin dashboard password — verified server-side (server/admin.ts).
# NOT prefixed VITE_ on purpose: VITE_ vars are embedded in the client bundle.
ADMIN_PASSWORD=changeme

# Neon Postgres — REQUIRED. Use the `dev` branch's DIRECT connection string
# (host WITHOUT `-pooler`) locally; production (`main` branch) is set in the
# Render dashboard.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
